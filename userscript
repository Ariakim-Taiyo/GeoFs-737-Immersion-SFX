(function() {
    'use strict';

    // Wait 10 second before run the script(if you directly run the script, there will no sound)
    setTimeout(() => {
        // Grab the script from GitHub and execute it
        fetch('https://raw.githubusercontent.com/Ariakim-Taiyo/GeoFs-737-Immersion-SFX/main/index.js')
            .then(response => response.text())
            .then(script => {
                const scriptElement = document.createElement('script');
                scriptElement.textContent = script;
                document.body.appendChild(scriptElement);
            });
    }, 10000); // 10000 ms = 10 second
